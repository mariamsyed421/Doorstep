# Doorstep — environment configuration. Everything is optional: with nothing set, the demo
# runs on synthetic data, a mock messaging provider, simulated outages and rule-based AI.
# Server-only values: never prefix secrets with VITE_. In Lovable, add these under Secrets.

# ---------- AI (centralized service: src/lib/doorstep/ai/service.server.ts) ----------
AI_PROVIDER=nemotron              # nemotron | gemini — preferred provider; the other is the fallback
NVIDIA_API_KEY=                   # NVIDIA API catalog key for Nemotron
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# Gemini fallback: Lovable's AI gateway is used when LOVABLE_API_KEY is present (Lovable sets it);
# otherwise a Google AI Studio key.
GEMINI_API_KEY=
GEMINI_MODEL=                     # default google/gemini-2.5-flash (gateway) or gemini-2.5-flash (direct)

# ---------- Photon messaging (UNVERIFIED adapter — confirm against Photon docs) ----------
PHOTON_API_BASE_URL=
PHOTON_API_KEY=
PHOTON_SEND_PATH=/messages
PHOTON_DEMO_RECIPIENT=            # ONE verified, consenting test number. Nothing is sent without it.
PHOTON_WEBHOOK_SECRET=            # enables HMAC-SHA256 verification on /api/webhook
PHOTON_SIGNATURE_HEADER=x-photon-signature

# ---------- Supabase persistence (optional; schema in docs/supabase-schema.sql) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server-only

# ---------- FEMA National Shelter System ----------
FEMA_NSS_LAYER_URL=https://gis.fema.gov/arcgis/rest/services/NSS/OpenShelters/MapServer/0
FEMA_SHELTERS_DISABLED=false
